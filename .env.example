NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Turnstile: clave pública para ingreso, registro y recuperación.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Eventos publicitarios: clave secreta de Supabase, solo en el servidor.
SUPABASE_SECRET_KEY=

# Campaña B: mantener desactivada para la beta.
SABINAPP_INTERSTITIAL_PUBLIC_ENABLED=false

# Noticias automáticas
OPENAI_API_KEY=
SABINAPP_NEWS_CRON_SECRET=
SABINAPP_NEWS_AUTO_PUBLISH=false
SABINAPP_NEWS_MAX_PUBLISHED_PER_RUN=3
SABINAPP_NEWS_MODEL=gpt-5-mini

# MET Norway: identificador y contacto del servicio.
# Configurar únicamente en el servidor.
SABINAPP_MET_USER_AGENT=Sabinapp/1.0 (contacto: correo@ejemplo.com)
